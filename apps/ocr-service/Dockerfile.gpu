# GPU-enabled Dockerfile for the OCR service.
# Requires: NVIDIA driver on the host, nvidia-container-toolkit in WSL2,
#           Docker Desktop with WSL2 backend and GPU passthrough enabled.
#
# Build:
#   docker compose build ocr-service   (when docker-compose.yml references this file)
#
# The CPU fallback is Dockerfile.simple (used automatically when no GPU is available).
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Install Python 3.11 and system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    tesseract-ocr \
    tesseract-ocr-tha \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python

WORKDIR /app

# PyTorch with CUDA 12.4 support — must be installed before easyocr so that
# easyocr picks up the GPU-enabled torch instead of a CPU wheel.
RUN pip install --no-cache-dir \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cu124

# Core service dependencies (mirrors Dockerfile.simple)
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0 \
    python-multipart==0.0.6 \
    httpx==0.25.2 \
    orjson==3.9.10 \
    Pillow==10.1.0 \
    numpy==1.25.2 \
    PyMuPDF==1.23.14 \
    opencv-python-headless==4.8.1.78 \
    pythainlp==3.1.0 \
    easyocr==1.7.1

# Docling packages
RUN pip install --no-cache-dir \
    docling==2.82.0 \
    docling-parse==5.6.2

COPY . /app

RUN useradd --create-home --shell /bin/bash app && \
    mkdir -p /data/poc && \
    chown -R app:app /app /data

USER app

CMD ["sh", "-c", "mkdir -p /data/poc/pages /data/poc/intermediate && uvicorn app.main:app --host 0.0.0.0 --port 8010"]
