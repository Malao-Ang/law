# Optimized Dockerfile with BuildKit cache mounts
# Build with: DOCKER_BUILDKIT=1 docker build -t ocr-service -f Dockerfile.optimized .

# syntax=docker/dockerfile:1
FROM python:3.11-slim AS base

# Install system dependencies
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-tha \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies with cache
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=bind,source=requirements.txt,target=requirements.txt \
    pip install --no-cache-dir -r requirements.txt

# Final stage
FROM python:3.11-slim

# Copy system packages from base
COPY --from=base /usr/bin/tesseract /usr/bin/
COPY --from=base /usr/bin/tesseract /usr/local/bin/
COPY --from=base /usr/share/tesseract-ocr /usr/share/tesseract-ocr/
COPY --from=base /usr/lib/tesseract-ocr /usr/lib/tesseract-ocr/
COPY --from=base /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu/
COPY --from=base /usr/lib /usr/lib/

WORKDIR /app

# Copy Python packages
COPY --from=base /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=base /usr/local/bin /usr/local/bin

# Copy application
COPY . /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash app && chown -R app:app /app
USER app

EXPOSE 8010

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
