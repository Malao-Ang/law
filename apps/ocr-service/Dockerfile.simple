# Simple Dockerfile for faster builds
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-tha \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    libreoffice-core \
    libreoffice-writer \
    fonts-thai-tlwg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies from the project requirements so the image and
# local test/runtime environments do not drift apart.
# requirements.txt does `-r requirements-heavy.txt`, so both must be present.
COPY requirements.txt requirements-heavy.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy application
COPY . /app

# Create non-root user and handle volume permissions
RUN useradd --create-home --shell /bin/bash app && \
    mkdir -p /data/poc && \
    chown -R app:app /app /data

# Switch to non-root user
USER app

# Ensure data directories are writable on startup
CMD ["sh", "-c", "mkdir -p /data/poc/pages /data/poc/intermediate && uvicorn app.main:app --host 0.0.0.0 --port 8010"]
