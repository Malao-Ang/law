{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/document-output.schema.json",
  "title": "DocumentOutput",
  "type": "object",
  "required": ["document_id", "source_file", "source_type", "language", "pages", "summary"],
  "properties": {
    "document_id": { "type": "string" },
    "source_file": { "type": "string" },
    "source_type": { "type": "string", "enum": ["docx", "pdf_text", "pdf_scan", "pdf_mixed"] },
    "language": { "type": "string", "const": "th" },
    "summary": {
      "type": "object",
      "required": ["page_count", "block_count", "review_required_count"],
      "properties": {
        "page_count": { "type": "integer", "minimum": 0 },
        "block_count": { "type": "integer", "minimum": 0 },
        "review_required_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "timings": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "scan_extraction_mode_requested": { "type": "string", "enum": ["auto", "local", "landingai", "gemini"] },
        "scan_extraction_mode_effective": { "type": "string", "enum": ["auto", "local", "landingai", "gemini"] }
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_no", "blocks"],
        "properties": {
          "page_no": { "type": "integer", "minimum": 1 },
          "image_path": { "type": ["string", "null"] },
          "image_url": { "type": ["string", "null"] },
          "source_kind": { "type": ["string", "null"], "enum": ["docx", "pdf_text", "pdf_scan", null] },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "block_id",
                "type",
                "reading_order",
                "raw_text",
                "normalized_text",
                "ai_suggested_text",
                "approved_text",
                "confidence",
                "needs_review"
              ],
              "properties": {
                "block_id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": [
                    "title",
                    "section_header",
                    "paragraph",
                    "list_item",
                    "table",
                    "image",
                    "figure_caption",
                    "footnote",
                    "unknown"
                  ]
                },
                "bbox": {
                  "type": ["array", "null"],
                  "items": { "type": "number" },
                  "minItems": 4,
                  "maxItems": 4
                },
                "reading_order": { "type": "integer", "minimum": 0 },
                "raw_text": { "type": "string" },
                "normalized_text": { "type": "string" },
                "ai_suggested_text": { "type": "string" },
                "approved_text": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "needs_review": { "type": "boolean" },
                "flags": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "section_path": { "type": ["string", "null"] },
                    "table_html": { "type": ["string", "null"] },
                    "reviewed_html": { "type": ["string", "null"] },
                    "table_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                    "table_detection_reason": { "type": ["string", "null"] },
                    "layout": {
                      "type": "object",
                      "properties": {
                        "bbox": {
                          "type": ["array", "null"],
                          "items": { "type": "number" },
                          "minItems": 4,
                          "maxItems": 4
                        },
                        "reading_order": { "type": ["integer", "null"] },
                        "alignment": { "type": ["string", "null"] },
                        "indent_left": { "type": ["integer", "null"] },
                        "indent_first_line": { "type": ["integer", "null"] },
                        "indent_hanging": { "type": ["integer", "null"] },
                        "indent_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
                        "indent_unit_pt": { "type": ["number", "null"] },
                        "first_line_inferred": { "type": ["string", "null"], "enum": ["leading_tab", null] },
                        "tabs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["align", "position"],
                            "properties": {
                              "align": { "type": "string" },
                              "position": { "type": "integer" }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": true
                    },
                    "list_marker": {
                      "type": ["object", "null"],
                      "required": ["text", "type", "level"],
                      "properties": {
                        "text": { "type": "string" },
                        "type": {
                          "type": "string",
                          "enum": [
                            "thai-numeral",
                            "arabic",
                            "legal-มาตรา",
                            "legal-ข้อ",
                            "legal-วรรค",
                            "paren",
                            "bullet"
                          ]
                        },
                        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                        "raw_match": { "type": "string" }
                      },
                      "additionalProperties": false
                    },
                    "image": {
                      "type": ["object", "null"],
                      "required": ["src_path"],
                      "properties": {
                        "src_path": { "type": "string" },
                        "src_url": { "type": ["string", "null"] },
                        "data_uri": { "type": ["string", "null"] },
                        "width": { "type": ["integer", "null"] },
                        "height": { "type": ["integer", "null"] },
                        "caption": { "type": ["string", "null"] }
                      },
                      "additionalProperties": true
                    },
                    "spell_suggestions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["token", "suggestion"],
                        "properties": {
                          "token": { "type": "string" },
                          "suggestion": { "type": "string" },
                          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                          "offset": { "type": "integer", "minimum": 0 }
                        },
                        "additionalProperties": false
                      }
                    },
                    "formatting": {
                      "type": ["object", "null"],
                      "properties": {
                        "weight":         { "type": ["string", "null"], "enum": ["bold", "medium", null] },
                        "bold_runs":      { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
                        "italic_runs":    { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
                        "underline_runs": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } }
                      },
                      "additionalProperties": false
                    },
                    "table": {
                      "type": ["object", "null"],
                      "properties": {
                        "headers": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        },
                        "cells": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["text", "colspan", "rowspan"],
                              "properties": {
                                "text": { "type": "string" },
                                "colspan": { "type": "integer", "minimum": 1 },
                                "rowspan": { "type": "integer", "minimum": 1 },
                                "alignment": { "type": ["string", "null"] }
                              },
                              "additionalProperties": false
                            }
                          }
                        },
                        "html": { "type": ["string", "null"] }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
